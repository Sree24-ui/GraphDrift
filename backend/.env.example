DATABASE_URL=sqlite:///./graphdrift.db
ENVIRONMENT=development
SESSION_SECRET=replace-with-a-long-random-secret-in-production
SESSION_TTL_SECONDS=43200

# Comma-separated list of allowed frontend origins for CORS.
# Required when the frontend is served from a different origin.
# Example: ALLOWED_ORIGINS=http://localhost:5173,https://graphdrift.example.com
ALLOWED_ORIGINS=http://localhost:5173

# Optional endpoint used only by backend/test_ws_client.py.
LIVE_FEED_WS_URL=ws://localhost:8000/ws/live-feed
